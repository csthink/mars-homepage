        "scopeRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "state": {
          "enum": [
            "queued",
            "reserved",
            "running",
            "stopping",
            "stopped",
            "completed",
            "failed",
            "unknown"
          ]
        },
        "connectionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
        },
        "configurationRevision": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 32
