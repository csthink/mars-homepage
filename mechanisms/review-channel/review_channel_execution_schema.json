    "PhysicalExecution": {
      "type": "object",
      "properties": {
        "executionRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]*$"
