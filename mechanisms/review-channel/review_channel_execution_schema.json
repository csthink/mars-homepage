          "enum": [
            "text/plain",
            "text/markdown",
            "text/html",
            "application/json",
            "application/octet-stream"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "authority",
        "resourceHandle",
        "scopeRef",
        "objectRef",
        "revision",
        "mediaType",
        "bytes",
        "digest"
